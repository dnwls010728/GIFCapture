<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <AssemblyName>GifCapture</AssemblyName>
    <RootNamespace>GifCapture</RootNamespace>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <!-- Controls are built in code, not the designer, so designer serialization attributes are unnecessary. -->
    <NoWarn>$(NoWarn);WFO1000</NoWarn>

    <Product>GIF Capture</Product>
    <AssemblyTitle>GIF Capture</AssemblyTitle>
    <Description>화면 영역을 녹화해 GIF로 편집·저장하는 도구</Description>
    <Version>1.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="app.ico" LogicalName="app.ico" />
  </ItemGroup>

  <!-- Release package: one self-contained exe, no .NET install needed. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
  </PropertyGroup>

</Project>
